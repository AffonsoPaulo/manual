{
    "name": "affonsopaulo/manual",
    "description": "Laravel package for serving Markdown documentation as a documentation site.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "markdown",
        "documentation",
        "manual"
    ],
    "require": {
        "php": "^8.5",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "league/commonmark": "^2.7",
        "scrivo/highlight.php": "^9.18",
        "symfony/yaml": "^7.2"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^12.2"
    },
    "autoload": {
        "psr-4": {
            "ServeraCloud\\Manual\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ServeraCloud\\Manual\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ServeraCloud\\Manual\\ManualServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
